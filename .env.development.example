# Local development: everything runs offline except uploads (Cloudinary).
# cp .env.development.example .env
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
MONGODB_URI=mongodb://127.0.0.1:27017/dooaa

# Codes are printed in the server log; 123456 is also accepted.
MAIL_TRANSPORT=log
SMS_DRIVER=log
OTP_DEV_CODE=123456

# The sandbox walks through the same initialize → pay → verify/webhook flow as Paystack.
PAYMENT_PROVIDER=sandbox
PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/callback

# "Continue with Google/Facebook" signs in offline as a sandbox user. Set OAUTH_DRIVER=live
# plus GOOGLE_/FACEBOOK_ credentials (redirect URIs on http://localhost:4000) to use the real ones.
OAUTH_DRIVER=sandbox

# Cloudinary is the upload destination; use STORAGE_DRIVER=local only to work offline.
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dooaa-dev

SEED_SUPERADMIN_PASSWORD=Dooaa@123
SEED_DEMO=true
