# ─────────────────────────────────────────────────────────────────────────────
# DOOAA API — environment
# Copy to .env and fill in. Values marked REQUIRED IN PRODUCTION stop the
# server from booting when missing there. Secrets must be long random strings:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Public URLs. APP_URL is this API; the other two are the Next.js apps
# (they are also the CORS allow-list). Add extra origins comma-separated.
APP_URL=https://api.dooaa.ng
CLIENT_URL=https://dooaa.ng
ADMIN_URL=https://admin.dooaa.ng
CORS_ORIGINS=

# ── Database ──────────────────────────────────────────────────── REQUIRED ──
# MongoDB Atlas (or any replica set / standalone 6+).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/dooaa?retryWrites=true&w=majority
MONGODB_DB=dooaa

# ── Auth ───────────────────────────────────────────── REQUIRED IN PRODUCTION ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_STAFF_SECRET=
OTP_PEPPER=
MEDIA_SIGNING_SECRET=
# Optional tuning
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
JWT_STAFF_ACCESS_TTL_SECONDS=900
JWT_STAFF_REFRESH_TTL_DAYS=1
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
AUTH_MAX_FAILED_SIGNINS=5
AUTH_LOCK_MINUTES=15
BCRYPT_ROUNDS=12
# Refresh-token cookie. Use none+secure when the apps and the API are on different sites.
COOKIE_SAMESITE=none
COOKIE_SECURE=true
# Development only: a fixed OTP accepted alongside real codes. Ignored in production.
OTP_DEV_CODE=

# ── Social sign-in (Google / Facebook) ─────────────────────────── OPTIONAL ──
# A provider without credentials is simply not offered. Register these
# redirect URIs with each provider (exactly, including https):
#   Google  (console.cloud.google.com → Credentials → OAuth client, "Web"):
#     ${APP_URL}/api/v1/auth/oauth/google/callback
#   Facebook (developers.facebook.com → Facebook Login → Valid OAuth Redirect URIs):
#     ${APP_URL}/api/v1/auth/oauth/facebook/callback
# OAUTH_DRIVER=sandbox (development only) signs in offline with a fake profile.
OAUTH_DRIVER=live
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0

# ── Payments (Paystack) ──────────────────────────────── REQUIRED IN PRODUCTION ──
# DOOAA never moves money itself: charges, refunds and seller payouts are
# executed by Paystack. Point the Paystack dashboard webhook at:
#   ${APP_URL}/api/v1/payments/webhooks/paystack
# and turn OFF "OTP for transfers" so payouts can be automated.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
# Where Paystack sends the buyer after paying (the client verifies from there).
PAYMENT_CALLBACK_URL=https://dooaa.ng/checkout/callback
# Sandbox only (PAYMENT_PROVIDER=sandbox, for development): signs its fake webhooks.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SANDBOX_DELAY_MS=800

# ── Uploads (Cloudinary) ─────────────────────────────── REQUIRED ──
# Cloudinary is the upload destination in every environment. For fully
# offline development you may set STORAGE_DRIVER=local instead.
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dooaa
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
MAX_FILE_MB=10

# ── Email (nodemailer over SMTP) ─────────────────────── REQUIRED IN PRODUCTION ──
MAIL_TRANSPORT=smtp
MAIL_FROM=DOOAA <no-reply@dooaa.ng>
SUPPORT_INBOX=support@dooaa.ng
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── SMS / WhatsApp codes (Termii) ────────────────────── REQUIRED IN PRODUCTION ──
SMS_DRIVER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=DOOAA
TERMII_BASE_URL=https://api.ng.termii.com

# ── Rate limits (requests per window) ─────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=20

# ── Background jobs (unpaid checkouts, auto-release, overdue orders) ─────────
SCHEDULER_ENABLED=true

# ── API docs at /docs (always on outside production) ─────────────────────────
SWAGGER_ENABLED=false

# ── Seeding: `npm run seed:prod` creates the first console superadmin ──────
SEED_SUPERADMIN_EMAIL=nelson@dooaa.com
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_FIRST_NAME=Nelson
SEED_SUPERADMIN_LAST_NAME=Doe
# SEED_DEMO=true adds the demo buyer, seller and listings (refused in production).
SEED_DEMO=false
